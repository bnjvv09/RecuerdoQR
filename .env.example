# ==========================================
# RECUERDOQR - VARIABLES DE ENTORNO DE PRODUCCIÓN
# ==========================================

# 1. Supabase (Base de datos y Storage de Fotos/Audios)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada

# 2. Mercado Pago Chile (Pasarela Oficial: Webpay, CuentaRUT, Visa, Mastercard)
# IMPORTANTE: En producción usar credenciales reales que empiezan con APP_USR-
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=tu-webhook-secret-de-mercadopago

# 3. Dominio Oficial de la Aplicación (Sin barra al final '/')
# IMPORTANTE: Cambiar a tu dominio de producción para que los códigos QR funcionen en celulares
NEXT_PUBLIC_APP_URL=https://recuerdoqr.cl

# 4. Resend (Servicio de Envío de Correos Automáticos de Compra)
# Regístrate gratis en https://resend.com y crea una API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=RecuerdoQR <hola@recuerdoqr.cl>
ADMIN_NOTIFICATION_EMAIL=tu-correo-admin@gmail.com

# 5. Seguridad de Administrador
ADMIN_PASSWORD=tu-clave-secreta-de-admin
JWT_SECRET=tu-secreto-aleatorio-para-sesiones-admin-de-32-caracteres
